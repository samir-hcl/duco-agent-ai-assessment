# Google Gemini API Key (optional - app works with mock data without it)
# Get your free key from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# API Authentication Key (optional in development, required in production)
# Protects mutation routes: POST /api/orchestrate, POST /api/approve
# If not set, all requests are allowed in dev mode with a logged warning.
DUCO_API_KEY=
